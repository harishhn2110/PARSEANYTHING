# Copy to .env if you want MinIO/S3. Empty keys use local data/objects/.
MAX_UPLOAD_BYTES=33554432
DATABASE_URL=sqlite:///data/atlas.db
OBJECT_DIR=data/objects
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=parseanything
S3_REGION=us-east-1
INLINE_JOBS=false
